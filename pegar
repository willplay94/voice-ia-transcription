#!/usr/bin/env python3
"""
Lo que VoxType ejecuta después de dejar el texto en el portapapeles.

Pulsa Ctrl+Shift+V y marca la tarjeta como "Pegado". El texto y su original
ya los publicó `corregir` un momento antes, así que aquí solo se cambia el
estado y se conserva lo que hubiera.

Antes este script también corregía, leyendo y escribiendo el portapapeles.
Eso se movió al hook `[output.post_process]`, que recibe el texto por stdin
y es mucho menos frágil.

Por qué se reescribe el portapapeles aquí: el demonio de VoxType arranca en
`default.target`, antes de que cinnamon-session importe DISPLAY al gestor de
usuario. Sin DISPLAY, xclip no puede conectar a X y VoxType registra "All
output methods failed" en cada dictado: el texto nunca llega al portapapeles.
El hook hereda ese mismo entorno roto, así que la reescritura desde aquí es
el último eslabón donde se puede garantizar que el texto correcto llegue al
portapapeles antes de pulsar Ctrl+Shift+V. (El drop-in de systemd
`voxtype.service.d/display.conf` arregla la raíz; esto es defensa en
profundidad por si el servicio se reinicia sin DISPLAY.)
"""

import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

import estado as st

TECLA_PEGAR = ["ydotool", "key", "ctrl+shift+v"]
ESPERA_ANTES_DE_PEGAR = 0.25  # el foco de la ventana necesita asentarse

# Ventana de frescura del estado propio. Si `corregir` no publicó (o publicó
# hace demasiado), no hay que tocar el portapapeles: escribir texto viejo
# sería peor que confiar en lo que VoxType dejó.
FRESCURA_MAX = 30.0


def leer_clipboard() -> str | None:
    """Devuelve el contenido del portapapeles, o None si xclip no funciona.

    Devuelve None (no "") cuando xclip falla — sin DISPLAY, sin dueño del
    portapapeles, etc. — para que la traza distinga "portapapeles vacío" de
    "no se pudo leer". Confundir los dos fue lo que ocultó el bug de DISPLAY
    durante horas: la traza decía `clipboard antes = ''` cuando en realidad
    xclip no podía conectar a X.
    """
    try:
        resultado = subprocess.run(
            ["xclip", "-selection", "clipboard", "-o"],
            capture_output=True, timeout=2,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    if resultado.returncode != 0:
        return None
    return resultado.stdout.decode("utf-8", errors="replace")


def escribir_clipboard(texto: str) -> bool:
    """Escribe `texto` al portapapeles. Devuelve True si xclip tuvo éxito.

    xclip deja un hijo vivo que sostiene el portapapeles en X11. Ese hijo era
    el bug cuando heredaba las tuberías de VoxType y lo dejaba en
    "transcribing" para siempre: por eso stdout y stderr van a /dev/null, se
    abre sesión nueva y el texto entra por `input=` en vez de por la tubería
    de VoxType.

    Comprueba el returncode: un subprocess.run sin check=True es un mentiroso
    silencioso — durante horas la traza dijo "portapapeles reescrito" cuando
    xclip devolvía exit 1 por falta de DISPLAY.
    """
    try:
        resultado = subprocess.run(
            ["xclip", "-selection", "clipboard"],
            input=texto.encode(),
            stdout=subprocess.DEVNULL, stderr=subprocess.PIPE,
            start_new_session=True, timeout=5,
        )
    except (OSError, subprocess.SubprocessError):
        return False
    if resultado.returncode != 0:
        err = resultado.stderr.decode("utf-8", errors="replace")[:80]
        st.traza(f"pegar: xclip devolvió {resultado.returncode}: {err!r}")
        return False
    return True


def main() -> int:
    st.traza("pegar: entra")
    time.sleep(ESPERA_ANTES_DE_PEGAR)

    # El texto corregido ya lo publicó `corregir` en el estado propio. Si es
    # reciente, se vuelve a escribir al portapapeles: es la defensa de último
    # eslabón por si VoxType no pudo escribirlo (sin DISPLAY, p. ej.).
    propio = st.leer_propio()
    fresco = (
        propio["estado"] in (st.CORRIGIENDO, st.PEGADO)
        and (time.time() - propio["ts"]) < FRESCURA_MAX
    )
    if fresco and propio["texto"]:
        previo = leer_clipboard()
        st.traza(f"pegar: clipboard antes = {previo[:60]!r}" if previo is not None
                 else "pegar: clipboard antes = <ilegible: xclip sin DISPLAY?>")
        if escribir_clipboard(propio["texto"]):
            st.traza("pegar: portapapeles reescrito con el texto propio")
        else:
            st.traza("pegar: xclip falló; se confía en el de VoxType")
    else:
        st.traza(
            f"pegar: estado no fresco ({propio['estado']}, ts={propio['ts']}); "
            "no se toca el portapapeles"
        )

    # ydotool INMEDIATAMENTE después de escribir el portapapeles, sin espera
    # extra entre ambos: cualquier pausa reintroduce un timing que no
    # controlamos. ydotool habla con ydotoold por socket, no necesita X.
    fallo = None
    try:
        subprocess.run(TECLA_PEGAR, timeout=5)
    except (OSError, subprocess.SubprocessError) as e:
        fallo = e
        print(f"no se pudo pegar: {e}", file=sys.stderr)

    # Marcar "Pegado" aunque ydotool falle: el texto está en el portapapeles
    # de todas formas, y dejar la tarjeta clavada en "Corrigiendo" es peor
    # que decir que ya terminó.
    try:
        st.actualizar_estado(st.PEGADO)
        st.traza("pegar: estado -> pegado")
    except (OSError, ValueError) as e:
        st.traza(f"pegar: no se pudo marcar pegado: {e}")

    return 1 if fallo else 0


if __name__ == "__main__":
    sys.exit(main())